  <object class="wxDialog" name="CTruncatePlaybackDlg">
    <style>wxDEFAULT_DIALOG_STYLE</style>
    <title>Truncate Playback?</title>
    <centered>1</centered>
    <object class="wxBoxSizer" name="bSizer70">
      <orient>wxHORIZONTAL</orient>
      <object class="sizeritem">
        <flag>wxEXPAND</flag>
        <border>5</border>
        <option>1</option>
        <object class="wxBoxSizer" name="bSizer71">
          <orient>wxVERTICAL</orient>
          <object class="sizeritem">
            <flag>wxALL</flag>
            <border>5</border>
            <option>0</option>
            <object class="wxStaticText" name="m_staticDesc">
              <label>You are not at the end of the move playback. You have the option of discarding all moves that occur after this point. The preceding moves will be stored in the Game History database.\n\nTruncating moves is useful in order to recover from a hopelessly flawed set of moves. You resume play at the state of the game where the playback was truncated.</label>
              <wrap>-1</wrap>
            </object>
          </object>
          <object class="sizeritem">
            <flag>wxTOP|wxRIGHT|wxLEFT</flag>
            <border>5</border>
            <option>0</option>
            <object class="wxRadioButton" name="m_radioTruncateSel">
              <label>NO! Do NOT...I repeat DO NOT truncate the playback.</label>
              <value>0</value>
            </object>
          </object>
          <object class="sizeritem">
            <flag>wxALL</flag>
            <border>5</border>
            <option>0</option>
            <object class="wxRadioButton" name="m_radioBtn3">
              <label>Yes. Truncate the playback and retain that state of the game.</label>
              <value>0</value>
            </object>
          </object>
        </object>
      </object>
      <object class="sizeritem">
        <flag></flag>
        <border>5</border>
        <option>0</option>
        <object class="wxBoxSizer" name="bSizer72">
          <orient>wxVERTICAL</orient>
          <object class="sizeritem">
            <flag>wxALL</flag>
            <border>5</border>
            <option>0</option>
            <object class="wxButton" name="wxID_OK">
              <label>OK</label>
              <default>1</default>
              <auth_needed>0</auth_needed>
              <markup>0</markup>
              <bitmap/>
            </object>
          </object>
          <object class="sizeritem">
            <flag>wxALL</flag>
            <border>5</border>
            <option>0</option>
            <object class="wxButton" name="wxID_CANCEL">
              <label>Cancel</label>
              <default>0</default>
              <auth_needed>0</auth_needed>
              <markup>0</markup>
              <bitmap/>
            </object>
          </object>
        </object>
      </object>
    </object>
